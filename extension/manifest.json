{
  "manifest_version": 3,
  "name": "cdpHelper",
  "version": "0.2.3",
  "description": "Extension service worker bridge for ModCDP custom commands and events.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "background": {
    "service_worker": "modcdp/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "cdpHelper",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["tabs", "debugger", "offscreen", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>", "http://localhost/*", "http://127.0.0.1/*", "ws://localhost/*", "ws://127.0.0.1/*"]
}
